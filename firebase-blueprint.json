{
  "entities": {
    "users": {
      "title": "UserProfile",
      "description": "User profile with role, email, and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["student", "teacher", "parent"] },
        "grade": { "type": "string", "maxLength": 100 },
        "avatarColor": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000000 },
        "bio": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "role", "avatarColor"]
    },
    "documents": {
      "title": "StudyDocument",
      "description": "Study booklet, revision, or book document metadata and content",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 50 },
        "customSubjectName": { "type": "string", "maxLength": 100 },
        "docType": { "type": "string", "maxLength": 50 },
        "format": { "type": "string", "maxLength": 50 },
        "grade": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 50 },
        "author": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "averageRating": { "type": "number" },
        "ratingsCount": { "type": "number" },
        "pageCount": { "type": "number" },
        "coverImageUrl": { "type": "string", "maxLength": 250000 },
        "annotationsJson": { "type": "string", "maxLength": 350000 },
        "bookmarks": { "type": "array" },
        "tags": { "type": "array" },
        "comments": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "subject", "docType", "grade", "term", "author", "userId", "createdAt", "updatedAt"]
    },
    "documentPages": {
      "title": "DocumentPage",
      "description": "Individual page image and annotations for cross-device study document rendering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "docId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "pageNumber": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 750000 },
        "annotationsJson": { "type": "string", "maxLength": 150000 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "docId", "userId", "pageNumber", "imageUrl", "updatedAt"]
    },
    "videos": {
      "title": "VideoItem",
      "description": "Educational Shorts and full video lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "author": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 200000 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["shorts", "lesson"] },
        "durationSeconds": { "type": "number" },
        "videoUrl": { "type": "string", "maxLength": 300000 },
        "thumbnailUrl": { "type": "string", "maxLength": 200000 },
        "subject": { "type": "string", "maxLength": 50 },
        "grade": { "type": "string", "maxLength": 100 },
        "likesCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "author", "title", "type", "durationSeconds", "subject", "createdAt", "updatedAt"]
    },
    "quizzes": {
      "title": "InteractiveQuiz",
      "description": "Interactive educational quizzes and question banks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "author": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "grade": { "type": "string", "maxLength": 100 },
        "durationMode": { "type": "string", "enum": ["always", "temporary", "timed"] },
        "expireDate": { "type": "string", "maxLength": 50 },
        "totalQuestions": { "type": "number" },
        "questionsJson": { "type": "string", "maxLength": 300000 },
        "subject": { "type": "string", "maxLength": 50 },
        "attemptsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "author", "title", "durationMode", "totalQuestions", "questionsJson", "subject", "createdAt", "updatedAt"]
    },
    "progress": {
      "title": "WeeklyStudyData",
      "description": "User weekly study hours and subject progress statistics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "weeklyGoalHours": { "type": "number" },
        "dailyProgressJson": { "type": "string", "maxLength": 10000 },
        "subjectProgressJson": { "type": "string", "maxLength": 10000 },
        "subjectSessionsJson": { "type": "string", "maxLength": 10000 },
        "lastUpdated": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "weeklyGoalHours", "dailyProgressJson", "subjectProgressJson", "subjectSessionsJson", "lastUpdated"]
    },
    "reminders": {
      "title": "StudyReminder",
      "description": "Study schedule reminder for a specific subject",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 50 },
        "customSubjectName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "targetDate": { "type": "string", "maxLength": 20 },
        "targetTime": { "type": "string", "maxLength": 10 },
        "repeatType": { "type": "string", "enum": ["once", "daily", "weekdays", "custom"] },
        "priority": { "type": "string", "enum": ["normal", "medium", "high"] },
        "isActive": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 },
        "linkedDocId": { "type": "string", "maxLength": 128 },
        "linkedDocTitle": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "subjectId", "title", "targetDate", "targetTime", "repeatType", "priority", "isActive", "isCompleted", "createdAt"]
    },
    "notes": {
      "title": "DocumentQuickNote",
      "description": "Student quick study text notes associated with a document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "docId": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 5000 },
        "pageNumber": { "type": "number" },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "docId", "content", "createdAt", "updatedAt"]
    },
    "comments": {
      "title": "InteractiveComment",
      "description": "Student interactive inquiry or comment on a video or document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["video", "document"] },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhotoURL": { "type": "string", "maxLength": 1000000 },
        "role": { "type": "string", "enum": ["student", "teacher", "parent"] },
        "content": { "type": "string", "maxLength": 2000 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "targetId", "targetType", "userId", "userName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document keyed by user authentication UID"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "notes",
      "description": "Quick text notes for study documents created by user"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "progress",
      "description": "User weekly study progress and analytics data"
    },
    "/documents/{documentId}": {
      "schema": "documents",
      "description": "Published or shared study documents and booklets"
    },
    "/documents/{documentId}/pages/{pageId}": {
      "schema": "documentPages",
      "description": "Original page images and page annotations for cross-device document viewing"
    },
    "/videos/{videoId}": {
      "schema": "videos",
      "description": "Published educational Shorts and video lessons"
    },
    "/quizzes/{quizId}": {
      "schema": "quizzes",
      "description": "Published interactive quizzes and question banks"
    },
    "/reminders/{reminderId}": {
      "schema": "reminders",
      "description": "User scheduled study reminders and subject alerts"
    },
    "/comments/{commentId}": {
      "schema": "comments",
      "description": "Interactive inquiries and comments on videos or documents"
    }
  }
}
